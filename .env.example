# Copy this file to .env and fill in a value to enable real AI experiment
# generation in the Builder's AI assistant. Without this, the AI assistant
# falls back to a deterministic mock generator (see
# src/services/aiExperimentService.ts) and clearly labels itself as such
# in the UI.
#
# SECURITY WARNING: this project has no backend, so this key is called
# directly from the browser and is visible to anyone who opens devtools on
# a deployed build. Only use this for local development. For a real
# deployment, add a backend endpoint that holds the key server-side and
# have aiExperimentService.ts call that endpoint instead.
VITE_ANTHROPIC_API_KEY=
